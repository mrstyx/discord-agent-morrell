# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_PREFIX=!

# Agent Configuration
AGENT_NAME=Morrell
AGENT_MODEL=gpt-4o
AGENT_SYSTEM_PROMPT=You are a helpful Discord bot assistant named Morrell. You help users in the Discord server with their questions and tasks.
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096

# GitHub Copilot SDK Authentication
# Generate a personal access token at https://github.com/settings/tokens
# Required scopes: read:user, copilot
GITHUB_TOKEN=your_github_personal_access_token_here

# Copilot API Endpoint (optional — defaults to https://api.githubcopilot.com)
COPILOT_API_ENDPOINT=https://api.githubcopilot.com

# Logging
LOG_LEVEL=INFO
